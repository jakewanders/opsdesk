{
  "name": "opsdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/test-db.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e SIT-251 \"Playwright suite.\"",
    "test": "node scripts/run-steps.mjs test",
    "check": "node scripts/run-steps.mjs check",
    "check:env": "node scripts/check-env-names.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/db-reset.mjs",
    "db:types": "node scripts/supabase.mjs gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "demo:seed": "node scripts/not-implemented.mjs demo:seed SIT-192 \"Demo seed registry.\"",
    "demo:cleanup": "node scripts/not-implemented.mjs demo:cleanup SIT-213 \"Expired-demo cleanup.\"",
    "smoke:routes": "node scripts/smoke-routes.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
