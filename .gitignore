# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (names only live in .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local volumes and secrets
supabase/.branches
supabase/.temp
supabase/.env
supabase/volumes

# local agent loop state
.claude/
.playwright-mcp/

# exports, test credentials, and test output
/exports/
*.export.csv
*.credentials*
.env.test.local
/e2e/.auth/
/playwright/.auth/
/playwright-report/
/test-results/

# the end-to-end run output kept for the log scan (SIT-275)
/.e2e-output.log
