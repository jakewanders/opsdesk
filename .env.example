# Copy to .env.local for local development. Never commit real values.
# Names only live here. Variables are validated at startup (src/lib/env).

# --- Public (embedded in the browser bundle; safe to expose) ---------------
# Supabase local stack prints these from `npm run db:start`.
# If your Supabase project still uses the legacy names: "anon" key = publishable key,
# "service_role" key = secret key (PRD 10.1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local only. Netlify production must use https://opsdesk.sitelaunch.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) -----------------------------
# Privileged: demo cleanup and guarded operations only, not basic CRUD.
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# --- Feature flags (true/false). P2 flags stay off until configured -----------
NEXT_PUBLIC_ENABLE_QUOTES=true
NEXT_PUBLIC_ENABLE_CSV_IMPORT=true
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_ENABLE_EMAIL=false
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_INTEGRATIONS=false

# --- Optional P2 integrations (server only) -----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
AI_API_KEY=
